# Standalone production compatibility example. It is not a deployable instance configuration.
# Copy it outside the repository, replace every fixture value, then chmod 600.
NODE_ENV=production
SHELL=/bin/zsh
NARU_AUTH_MODE=app-managed
NARU_PASSWORD_HASH=scrypt$32768$8$1$replace-with-salt$replace-with-hash
NARU_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Keep this explicit so production preflight output can be checked before a restart.
NARU_SESSION_COOKIE_NAME=naru_session

# These documentation-only addresses use a non-instance fixture subnet. Bind one exact approved
# private address and never use 0.0.0.0.
# The source compatibility server accepts only this exact fixture. Configurable instance ingress
# belongs to the Workstation Gateway PrivateIngress contract.
NARU_HOST=10.23.45.10
NARU_PORT=8443
NARU_ALLOWED_ORIGINS=https://naru.example.test:8443
# List only exact approved client addresses. CIDR and forwarded-address inference are forbidden.
NARU_ALLOWED_CLIENT_IPS=10.23.45.11,10.23.45.12,10.23.45.10

# Naru reads only the published certificate generation. Keep this state outside the repository.
# Do not add the Cloudflare DNS API token here; the later certificate-renewal process owns it.
NARU_TLS_STATE_DIR="/Users/example/Library/Application Support/Naru/tls"
NARU_TLS_RELOAD_INTERVAL_MS=10000

# T32 Web Push is optional, but these three names are all-or-none. Generate one P-256 VAPID
# key pair outside the repository and keep the private key only in the external 0600 environment.
# NARU_VAPID_PUBLIC_KEY=<url-safe-base64-public-key>
# NARU_VAPID_PRIVATE_KEY=<url-safe-base64-private-key>
# NARU_VAPID_SUBJECT=https://naru.example.test:8443

NARU_PROJECT_ROOTS=/Users/example/projects
NARU_DATA_DIR="/Users/example/Library/Application Support/Naru/data"
NARU_WEB_DIST="/Users/example/Library/Application Support/Naru/releases/current/apps/web/dist"
NARU_APP_BASE_PATH=/
NARU_CODEX_PATH=/opt/homebrew/bin/codex
