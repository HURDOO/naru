# Development-only standalone compatibility environment. Workstation packaging uses Gateway-managed
# Naru and is configured separately. Production launchd uses ops/naru.env.example outside the repo.
NARU_AUTH_MODE=app-managed
# Generate this value with: pnpm password:hash
NARU_PASSWORD_HASH=scrypt$32768$8$1$replace-with-salt$replace-with-hash

# Use at least 32 random characters. Never commit the real value.
NARU_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Browser cookies are host-scoped, not port-scoped. Give each concurrently used worktree a unique
# valid cookie token; the development default is naru_dev_session when this setting is omitted.
NARU_SESSION_COOKIE_NAME=naru_dev_session

NARU_HOST=127.0.0.1
NARU_PORT=4174
NARU_ALLOWED_ORIGINS=http://127.0.0.1:5173
# LAN bind에는 승인한 기기의 정확한 현재 IP만 나열합니다. CIDR은 허용하지 않습니다.
# 아래 주소는 문서용 예시이며 실제 네트워크 값으로 교체해야 합니다.
# NARU_ALLOWED_CLIENT_IPS=10.23.45.42,10.23.45.10
NARU_PROJECT_ROOTS=/Users/example/projects
NARU_DATA_DIR=.local
# Optional absolute override when `codex` is not on the service PATH.
# NARU_CODEX_PATH=/opt/homebrew/bin/codex
# Production build only: NARU_WEB_DIST=apps/web/dist
