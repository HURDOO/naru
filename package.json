{
  "name": "naru",
  "version": "0.0.0",
  "private": true,
  "description": "A personal web Agent IDE that carries terminal work across devices.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter './apps/*' dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:operations": "vitest run apps/server/test/environment-file.test.ts apps/server/test/database-backup.test.ts apps/server/test/operations.test.ts apps/server/test/discord-notifier.test.ts apps/server/test/maintenance.test.ts apps/server/test/cloudflare-dns.test.ts apps/server/test/authoritative-dns.test.ts apps/server/test/acme-renewal.test.ts apps/server/test/tls-certificate.test.ts apps/server/test/shutdown.test.ts",
    "test:production-smoke": "NARU_APP_BASE_PATH=/ pnpm build && playwright test --config playwright.production.config.ts",
    "test:private-ingress-acceptance": "PRIVATE_INGRESS_ACTUAL_ACCEPTANCE=1 vitest run apps/server/test/private-ingress-release.actual.acceptance.test.ts",
    "test:performance": "pnpm test:performance:terminal && pnpm test:performance:browser",
    "test:performance:browser": "playwright test --config playwright.performance.config.ts",
    "test:performance:terminal": "node --expose-gc --import tsx tests/performance/terminal-load.ts",
    "workstation:dev:profile": "tsx ops/workstation/dev/runtime-profile-cli.ts show",
    "workstation:dev:check": "tsx ops/workstation/dev/runtime-profile-cli.ts check",
    "workstation:dev:prepare": "tsx ops/workstation/dev/runtime-profile-cli.ts prepare",
    "workstation:mcp:check": "node ops/workstation/dev/run-node24.mjs --import tsx ops/workstation/dev/playwright-mcp.ts --check",
    "workstation:preflight": "node ops/workstation/dev/run-node24.mjs --import tsx ops/workstation/dev/native-preflight.ts",
    "workstation:distribution:test": "vitest run ops/workstation/distribution",
    "workstation:distribution:build": "node ops/workstation/dev/run-node24.mjs --import tsx ops/workstation/distribution/build-artifact.ts",
    "audit:security": "pnpm audit --audit-level high",
    "public:scan": "node scripts/public-scan.mjs",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "password:hash": "pnpm --filter @naru/server password:hash",
    "ops": "pnpm --filter @naru/server operations",
    "start": "pnpm --filter @naru/server start"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
